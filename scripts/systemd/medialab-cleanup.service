[Unit]
Description=Medialab Cleanup Service
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/medialab/scripts/utilities/cleanup.sh
User=root
WorkingDirectory=/opt/medialab

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=medialab-cleanup

[Install]
WantedBy=multi-user.target
