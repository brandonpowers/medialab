#!/bin/bash
#
# homelab - Main CLI entry point for homelab automation
# Unified interface for setup, configuration, and management
#
# Usage:
#   ./scripts/homelab setup              Run setup phase
#   ./scripts/homelab configure          Run configure phase (includes Homepage)
#   ./scripts/homelab all                Run setup and configure phases
#   ./scripts/homelab status             Show service status
#   ./scripts/homelab --help             Show help
#
# Options:
#   --json           Output JSON format (for UI)
#   --config FILE    Read configuration from JSON file
#

set -euo pipefail

# Script directory (use unique name to avoid collision with sourced scripts)
HOMELAB_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$HOMELAB_SCRIPT_DIR/.." && pwd)"

# Source library
source "$HOMELAB_SCRIPT_DIR/lib/init.sh"

# ============================================
# VERSION AND HELP
# ============================================

VERSION="2.0.0"

show_help() {
    cat << EOF
Homelab CLI - Video Streaming Infrastructure Automation

USAGE:
    homelab <command> [options]

COMMANDS:
    start           Launch the web UI setup wizard
    setup           Run initial setup (Docker, storage, environment)
    configure       Configure services via API (includes Homepage dashboard)
    all             Run setup and configure phases
    status          Show service status

OPTIONS:
    --json          Output JSON format (for UI integration)
    --config FILE   Read configuration from JSON file
    -h, --help      Show this help message
    -v, --version   Show version

EXAMPLES:
    ./homelab start
    ./homelab setup
    ./homelab configure

For more information, see: docs/README.md
EOF
}

show_version() {
    echo "homelab version $VERSION"
}

# ============================================
# PHASE RUNNERS
# ============================================

run_start() {
    exec "$HOMELAB_SCRIPT_DIR/run-ui.sh"
}

run_setup() {
    local json_flag=""
    [[ "$OUTPUT_MODE" == "json" ]] && json_flag="--json"

    print_header "SETUP PHASE"

    cd "$PROJECT_ROOT"

    # Run setup modules in order
    local modules=(
        "01-prerequisites.sh"
        "02-detect-hardware.sh"
        "03-select-media-drive.sh"
        "04-generate-env.sh"
        "05-create-directories.sh"
        "05b-generate-homepage-config.sh"
        "06-setup-arm-udev.sh"
        "07-pull-images.sh"
        "08-start-services.sh"
    )

    local total=${#modules[@]}
    local current=0

    for module in "${modules[@]}"; do
        ((++current))
        local module_path="$HOMELAB_SCRIPT_DIR/modules/setup/$module"

        if [[ ! -f "$module_path" ]]; then
            report_log "warning" "Module not found: $module"
            continue
        fi

        report_progress "$current" "$total" "Running ${module%.sh}..." "running"

        if bash "$module_path" $json_flag; then
            report_progress "$current" "$total" "${module%.sh} complete" "complete"
        else
            report_progress "$current" "$total" "${module%.sh} failed" "error"
            if [[ "$OUTPUT_MODE" != "json" && -t 0 ]]; then
                echo ""
                read -r -p "Continue anyway? (y/N): " response
                [[ ! "$response" =~ ^[Yy]$ ]] && exit 1
            else
                # Non-interactive mode - exit on failure
                exit 1
            fi
        fi
    done

    echo ""
    print_success "Setup phase complete!"
    echo ""
    print_info "Next: Wait 2-3 minutes for services to initialize, then run:"
    print_info "  ./scripts/homelab configure"
}

run_configure() {
    local json_flag=""
    [[ "$OUTPUT_MODE" == "json" ]] && json_flag="--json"

    print_header "CONFIGURE PHASE"

    cd "$PROJECT_ROOT"

    # Check if services are running
    if ! docker compose ps 2>/dev/null | grep -q "Up" ; then
        print_error "Services are not running. Run setup first:"
        print_info "  sudo ./scripts/homelab setup"
        exit 1
    fi

    local module_dir="$HOMELAB_SCRIPT_DIR/modules/configure"

    if [[ -d "$module_dir" ]] && ls "$module_dir"/*.sh &>/dev/null; then
        # Run modular configure scripts
        local modules=($(ls "$module_dir"/*.sh | sort))
        local total=${#modules[@]}
        local current=0
        local succeeded=0
        local failed=0

        for module in "${modules[@]}"; do
            ((++current))
            local module_name=$(basename "$module" .sh)

            report_progress "$current" "$total" "Running ${module_name}..." "running"

            if bash "$module" $json_flag; then
                report_progress "$current" "$total" "${module_name} complete" "complete"
                ((++succeeded))
            else
                report_progress "$current" "$total" "${module_name} failed" "warning"
                ((++failed))
                # Continue with other modules even if one fails
            fi
        done

        echo ""
        print_success "Configure phase complete!"
        print_info "  Succeeded: $succeeded modules"
        [[ $failed -gt 0 ]] && print_warning "  Failed: $failed modules (may need manual configuration)"
    else
        print_error "No configure modules found in $module_dir"
        exit 1
    fi
}

run_all() {
    run_setup
    echo ""
    print_info "Waiting for services to initialize..."
    sleep 30
    run_configure
}

show_status() {
    print_header "SERVICE STATUS"

    cd "$PROJECT_ROOT"

    if [[ "$OUTPUT_MODE" == "json" ]]; then
        docker compose ps --format json 2>/dev/null || docker compose ps
    else
        docker compose ps

        echo ""
        local lan_ip
        lan_ip=$(hostname -I | awk '{print $1}')
        print_info "Access services at: http://${lan_ip}:<port>"
    fi
}

# ============================================
# MAIN
# ============================================

main() {
    # Parse global options
    local command=""
    local config_file=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            --json)
                export OUTPUT_MODE="json"
                shift
                ;;
            --config)
                config_file="$2"
                shift 2
                ;;
            --config=*)
                config_file="${1#*=}"
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            -*)
                print_error "Unknown option: $1"
                show_help
                exit 1
                ;;
            *)
                command="$1"
                shift
                break
                ;;
        esac
    done

    # Export config file for modules
    [[ -n "$config_file" ]] && export HOMELAB_CONFIG="$config_file"

    # Execute command
    case "$command" in
        start)
            run_start
            ;;
        setup)
            run_setup "$@"
            ;;
        configure)
            run_configure "$@"
            ;;
        all)
            run_all "$@"
            ;;
        status)
            show_status "$@"
            ;;
        "")
            show_help
            exit 0
            ;;
        *)
            print_error "Unknown command: $command"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
