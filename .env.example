# ============================================
# HOMELAB MEDIA SERVER ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values
# Command: cp .env.example .env
#
# IMPORTANT: .env contains sensitive credentials!
# - Never commit .env to version control (already in .gitignore)
# - Use strong, unique passwords
# - Keep this file secure
# ============================================

# ============================================
# SYSTEM CONFIGURATION
# ============================================

# Timezone (find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# Examples: America/New_York, Europe/London, Asia/Tokyo, America/Los_Angeles
TZ=America/Chicago

# User and Group IDs (run `id` command on your system to find these)
# Ensures Docker containers create files with correct ownership
# Run: id -u (for PUID) and id -g (for PGID)
PUID=1000
PGID=1000

# Media storage path INSIDE the container (do NOT change unless modifying docker-compose.yml)
# This is where /mnt/media from the host is mounted inside containers
MEDIA_ROOT=/mnt/media

# ============================================
# REMOTE ACCESS CONFIGURATION
# ============================================

# Cloudflare Tunnel Token
# Get from: https://one.dash.cloudflare.com/ > Zero Trust > Networks > Tunnels > Create Tunnel
# See README.md "Cloudflare Tunnel Setup" section for detailed instructions
# Format: eyJ... (very long base64 string starting with eyJ)
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Tailscale (for remote admin access)
# NOTE: Tailscale is installed on the HOST, not as a Docker container
# Run setup script or install manually: curl -fsSL https://tailscale.com/install.sh | sh
# Then connect: sudo tailscale up --hostname=homelab

# ============================================
# DATABASE & CACHE CONFIGURATION
# ============================================

# Shared PostgreSQL Database
# Used by: Immich, Jellyseerr, Uptime Kuma
# Databases created automatically: immich, jellyseerr, uptimekuma
# Admin access: docker exec -it postgres psql -U homelab
# Generate secure password: openssl rand -base64 32
DB_USER=homelab
DB_PASSWORD=your_secure_database_password_here

# Shared Redis Cache
# Used by: Immich (caching and job queues)
# Admin access: docker exec -it redis redis-cli -a $REDIS_PASSWORD
# Generate secure password: openssl rand -base64 32
REDIS_PASSWORD=your_secure_redis_password_here

# ============================================
# API KEYS & INTEGRATIONS
# ============================================

# The Movie Database (TMDB) API Key
# Required for: Jellyseerr media discovery and metadata
# Get from: https://www.themoviedb.org/settings/api (free account required)
# Steps: 1) Create account, 2) Request API key, 3) Copy "API Key (v3 auth)"
# Format: 32-character hexadecimal string
TMDB_API_KEY=your_tmdb_api_key_here

# ============================================
# Homarr
# ============================================

# Homarr requires an encryption key, generate one with the command below.
# openssl rand -hex 32
HOMARR_ENCRYPTION_KEY=your_homarr_encryption_key

# ============================================
# RECYCLARR API KEYS (Optional - configure after initial setup)
# ============================================
# These are only needed AFTER you've completed initial service setup
# Get from each application: Settings > General > Security > API Key
# Then update this file and run: docker compose run --rm recyclarr sync

# Sonarr API Key
# Get from: Sonarr > Settings > General > Security > API Key
SONARR_API_KEY=your_sonarr_api_key_here

# Radarr API Key
# Get from: Radarr > Settings > General > Security > API Key
RADARR_API_KEY=your_radarr_api_key_here

# SABnzbd API Key (Optional - only needed if using Usenet)
# Get from: SABnzbd > Config > General > Security > API Key
# Leave blank if not using Usenet
SABNZBD_API_KEY=

# ============================================
# OPTIONAL CONFIGURATION
# ============================================

# Domain name (for reference - not actively used with Cloudflare Tunnel)
# Your domain managed by Cloudflare
DOMAIN=yourdomain.io

# Email address (for notifications or Let's Encrypt if needed in future)
EMAIL=your-email@example.com

# ============================================
# GETTING STARTED CHECKLIST
# ============================================
# Before starting the stack:
# [ ] Update TZ to your timezone
# [ ] Set PUID and PGID (run `id` command)
# [ ] Generate and set DB_PASSWORD (openssl rand -base64 32)
# [ ] Generate and set REDIS_PASSWORD (openssl rand -base64 32)
# [ ] Add Cloudflare Tunnel token
# [ ] Add TMDB API key
# [ ] Verify MEDIA_ROOT matches your media mount
# [ ] Save this file as .env
# [ ] Run: docker compose up -d
#
# After services are running:
# [ ] Get API keys from Sonarr, Radarr, Readarr
# [ ] Update this .env with API keys
# [ ] Run: docker compose run --rm recyclarr sync
# ============================================
