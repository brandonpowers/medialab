# ============================================
# MEDIALAB MEDIA SERVER ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and fill in your values
# Command: cp .env.example .env
#
# IMPORTANT: .env contains sensitive credentials!
# - Never commit .env to version control (already in .gitignore)
# - Use strong, unique passwords
# - Keep this file secure
# ============================================

# ============================================
# ADMIN ACCOUNT
# ============================================
# Global administrator credentials used across all services
# This username and password will be configured for:
# Jellyfin, Sonarr, Radarr, Lidarr, Prowlarr, qBittorrent, etc.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ============================================
# SYSTEM CONFIGURATION
# ============================================

# Timezone (find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
# Examples: America/New_York, Europe/London, Asia/Tokyo, America/Los_Angeles
TZ=America/Chicago

# User and Group IDs (run `id` command on your system to find these)
# Ensures Docker containers create files with correct ownership
# Run: id -u (for PUID) and id -g (for PGID)
PUID=1000
PGID=1000

# Docker group GID (for Homepage to access Docker socket)
# Run: getent group docker | cut -d: -f3
# Auto-detected by setup script
DOCKER_GID=

# Media storage path on the host
# This is where your media files are stored
MEDIA_ROOT=/mnt/media

# ============================================
# REMOTE ACCESS CONFIGURATION (Optional)
# ============================================

# Cloudflare Tunnel Token
# Get from: https://one.dash.cloudflare.com/ > Zero Trust > Networks > Tunnels > Create Tunnel
# See docs/networking.md for detailed instructions
# Format: eyJ... (very long base64 string starting with eyJ)
# Leave empty if not using Cloudflare Tunnel (services will only be accessible on LAN)
CLOUDFLARE_TUNNEL_TOKEN=

# Domain name (only needed if using Cloudflare Tunnel)
DOMAIN=yourdomain.com

# ============================================
# API KEYS & INTEGRATIONS
# ============================================

# The Movie Database (TMDB) API Key
# Required for: Jellyseerr media discovery, ARM disc identification
# Get from: https://www.themoviedb.org/settings/api (free account required)
# Steps: 1) Create account, 2) Request API key, 3) Copy "API Key (v3 auth)"
# Format: 32-character hexadecimal string
TMDB_API_KEY=

# ============================================
# HOMEPAGE DASHBOARD
# ============================================

# Homepage uses file-based YAML configuration - no env vars needed
# Configuration is auto-generated in data/homepage/config/

# ============================================
# SERVICE API KEYS (Auto-populated by medialab configure)
# ============================================
# These are extracted automatically when you run ./scripts/medialab configure
# You can also get them manually from each app: Settings > General > API Key

# Sonarr API Key (for Recyclarr and Jellyseerr integration)
SONARR_API_KEY=

# Radarr API Key (for Recyclarr and Jellyseerr integration)
RADARR_API_KEY=

# SABnzbd API Key (Optional - only needed if using Usenet)
# Get from: SABnzbd > Config > General > Security > API Key
SABNZBD_API_KEY=

# Tdarr API Key (Auto-generated - used for authenticated API access)
# Must start with tapi_, be 14+ chars, alphanumeric + underscore
TDARR_API_KEY=

# ============================================
# GETTING STARTED CHECKLIST
# ============================================
# Before starting the stack:
# [ ] Update TZ to your timezone
# [ ] Set PUID and PGID (run `id` command)
# [ ] Homepage config is auto-generated during setup
# [ ] (Optional) Add Cloudflare Tunnel token for remote access
# [ ] (Optional) Add TMDB API key for media discovery
# [ ] Save this file as .env
# [ ] Run: ./scripts/medialab setup
#
# After services are running:
# [ ] Run: ./scripts/medialab configure (auto-links all services)
# [ ] API keys will be auto-populated in .env
# ============================================
